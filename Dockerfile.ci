FROM anatolelucet/neovim:0.12-bookworm@sha256:0711c06173d35da82febebe12cc6b5ab1a683b0a61974741fda9d55f291a6dd4

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
     build-essential \
     ca-certificates \
     curl \
     git \
     luarocks \
 && luarocks install luacheck \
 && rm -rf /var/lib/apt/lists/*
