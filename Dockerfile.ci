FROM anatolelucet/neovim:latest-bookworm@sha256:60ae5e2a9ef5ee82d9bacc819614a81dc5860d39b0bdb985835ba7fce31825d2

ARG LUALS_VERSION=3.19.1

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
     build-essential \
     ca-certificates \
     curl \
     git \
     luarocks \
 && luarocks install luacheck \
 && set -eux; \
    case "$(uname -m)" in \
      x86_64) luals_arch="x64" ;; \
      aarch64|arm64) luals_arch="arm64" ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL \
      "https://github.com/LuaLS/lua-language-server/releases/download/${LUALS_VERSION}/lua-language-server-${LUALS_VERSION}-linux-${luals_arch}.tar.gz" \
      -o /tmp/lua-language-server.tar.gz; \
    mkdir -p /opt/lua-language-server; \
    tar -xzf /tmp/lua-language-server.tar.gz -C /opt/lua-language-server; \
    # LuaLS writes generated meta files on first run; allow arbitrary CI UID to write there.
    install -d -m 0777 /opt/lua-language-server/meta; \
    ln -s /opt/lua-language-server/bin/lua-language-server /usr/local/bin/lua-language-server; \
    rm /tmp/lua-language-server.tar.gz \
 && rm -rf /var/lib/apt/lists/*
