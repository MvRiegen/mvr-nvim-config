FROM anatolelucet/neovim:0.12-bookworm@sha256:c1567f5641d1dc5c89457cbfb35fdd8b95c06cd8edb9e7856f62d371da8f0447

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
     build-essential \
     ca-certificates \
     curl \
     git \
     luarocks \
 && luarocks install luacheck \
 && rm -rf /var/lib/apt/lists/*
