FROM anatolelucet/neovim:0.12-bookworm@sha256:3b7ac4ca402fe820c5840234a5e9e70ae4000fd3dd1ee3d9f50088f0b960721f

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
     build-essential \
     ca-certificates \
     curl \
     git \
     luarocks \
 && luarocks install luacheck \
 && rm -rf /var/lib/apt/lists/*
