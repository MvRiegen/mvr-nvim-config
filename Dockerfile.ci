FROM anatolelucet/neovim:0.12-bookworm@sha256:bb55a10ba8c2b9332ec4c761e448d4ad25260971ff457756be683613c2b1b437

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
     build-essential \
     ca-certificates \
     curl \
     git \
     luarocks \
 && luarocks install luacheck \
 && rm -rf /var/lib/apt/lists/*
